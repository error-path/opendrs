{
  "name": "@error-path/opendrs",
  "version": "0.5.1",
  "mcpName": "io.github.error-path/opendrs",
  "description": "Open Diff Risk Score: a calibrated 0-1 risk score for every pull request, for risk-based auto-approval.",
  "type": "module",
  "license": "MIT",
  "author": "error-path",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/error-path/opendrs.git"
  },
  "homepage": "https://error-path.github.io/opendrs/",
  "bugs": "https://github.com/error-path/opendrs/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "code-review",
    "risk",
    "diff",
    "pull-request",
    "auto-merge",
    "blast-radius",
    "defect-prediction",
    "mcp",
    "github-action",
    "auto-approve",
    "merge-queue",
    "ai-code-review",
    "pr-risk",
    "claude-code"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "opendrs": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    ".claude-plugin",
    "LICENSE",
    "README.md",
    "dist",
    "plugin",
    "!plugin/evals"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "build:action": "node scripts/record-run.mjs build:action -- esbuild src/action/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=action/dist/index.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/record-run.mjs test -- vitest run",
    "test:slow": "node scripts/record-run.mjs test:slow -- vitest run --config vitest.slow.config.ts",
    "check": "node scripts/record-run.mjs check -- node scripts/run-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
