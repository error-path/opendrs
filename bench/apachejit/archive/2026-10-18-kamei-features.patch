   }
   const files = countedFiles(ctx);
   const days = ctx.config.history.lookbackDays;
@@ -44,9 +50,37 @@ export const historySignals: SignalProvider = async (ctx) => {
     summary: `${plural(recent.size, "commit")} touched these files ${window}`,
     evidence: topEvidence(perFile.sort((a, b) => b.n - a.n).map(({ file, n }) => ({ file, detail: `${plural(n, "commit")} ${window}` }))),
   };
-  return [priorFixes, await incidentSignal(ctx, files), churn].map((s) => shallowAware(ctx, s));
+  return [priorFixes, await incidentSignal(ctx, files), churn, fileAge(ctx, files, now), uniqueChanges(ctx, files)].map((s) => shallowAware(ctx, s));
 };
 
+/** Kamei's "age": mean days since each pre-existing changed file was last changed. */
+function fileAge(ctx: ScoringContext, files: ChangedFile[], now: number): Signal {
+  const ages = files.flatMap((f) => {
+    const last = f.status === "added" ? undefined : ctx.history.fileCommits(historyPath(f), ctx.asOf)[0];
+    return last ? [{ file: f.path, days: (now - last.time) / 86_400 }] : [];
+  });
+  const mean = ages.length ? ages.reduce((n, a) => n + a.days, 0) / ages.length : 0;
+  return {
+    id: "history.file_age",
+    value: Math.log1p(mean),
+    status: "derived",
+    summary: ages.length ? `changed files were last changed ${Math.round(mean)} days ago on average` : "no pre-existing file with history changed",
+    evidence: topEvidence(ages.sort((a, b) => a.days - b.days).map(({ file, days }) => ({ file, detail: `last changed ${Math.round(days)} days ago` }))),
+  };
+}
+
+/** Kamei's "nuc": distinct prior commits that touched any changed file, with no lookback window. */
+function uniqueChanges(ctx: ScoringContext, files: ChangedFile[]): Signal {
+  const shas = new Set(files.flatMap((f) => ctx.history.fileCommits(historyPath(f), ctx.asOf).map((c) => c.sha)));
+  return {
+    id: "history.unique_changes",
+    value: Math.log1p(shas.size),
+    status: "derived",
+    summary: `${plural(shas.size, "prior commit")} touched these files`,
+    evidence: [],
+  };
+}
+
 /** A past incident: when it became known, and which files and folders it implicates. */
 interface IncidentEvent {
   time?: number;
