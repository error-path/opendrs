 };
 
+/**
+ * Kamei's "ent": Shannon entropy of the changed lines across the files that have any, divided by its
+ * maximum log2(n), so 1 means evenly spread and 0 means one file holds every line.
+ */
+function entropySignal(lines: number[]): Signal {
+  const counts = lines.filter((n) => n > 0);
+  const total = counts.reduce((a, b) => a + b, 0);
+  const h = counts.reduce((sum, n) => sum - (n / total) * Math.log2(n / total), 0);
+  const value = counts.length > 1 ? h / Math.log2(counts.length) : 0;
+  return {
+    id: "diffusion.entropy",
+    value,
+    status: "observed",
+    summary: `changed lines spread over ${plural(counts.length, "file")} with normalized entropy ${value.toFixed(2)}`,
+    evidence: [],
+  };
+}
+
 /** First two directory levels of a path; "." for files at the repo root. */
 function topDir(path: string): string {
   const parts = path.split("/").slice(0, -1);
