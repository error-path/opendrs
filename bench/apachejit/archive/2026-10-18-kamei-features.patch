-    const why = "no commit history before this change";
-    return [unknown("expertise.author_commits", why), unknown("expertise.owner_ratio", why)];
-  }
+  if (!email) return allUnknown("author email unknown for the head commit");
+  if (!historyAvailable(ctx)) return allUnknown("no commit history before this change");
 
   const prior = ctx.history.authorCommitCount(email, ctx.asOf);
   const authorCommits: Signal = {
@@ -28,9 +25,49 @@ export const expertiseSignals: SignalProvider = async (ctx) => {
     summary: `${email} has ${plural(prior, "prior commit")} in this repo`,
     evidence: [],
   };
-  return [authorCommits, ownerRatio(ctx, email)];
+  return [authorCommits, ownerRatio(ctx, email), subsystem(ctx, email)];
 };
 
+/** Kamei's "sexp": the author's prior commits that touched any top-level directory this change touches. */
+function subsystem(ctx: ScoringContext, email: string): Signal {
+  const dirs = new Set(countedFiles(ctx).map((f) => topLevel(f.path)));
+  let n = 0;
+  for (const c of authorCommitsFor(ctx.history).get(email) ?? []) {
+    if (ctx.asOf !== undefined && c.time >= ctx.asOf) break;
+    if (c.dirs.some((d) => dirs.has(d))) n++;
+  }
+  return {
+    id: "expertise.subsystem",
+    value: Math.log1p(n),
+    status: "derived",
+    summary: `${email} has ${plural(n, "prior commit")} in ${[...dirs].slice(0, 5).join(", ") || "no directory"}`,
+    evidence: [],
+  };
+}
+
+const topLevel = (path: string): string => (path.includes("/") ? path.slice(0, path.indexOf("/")) : ".");
+
+// Backtests score thousands of commits against one HistoryIndex; group its commits by author once.
+const byAuthor = new WeakMap<HistoryIndex, Map<string, Array<{ time: number; dirs: string[] }>>>();
+
+/** Each author's non-merge commits (like authorCommitCount), oldest first, with the top-level directories they touched. */
+function authorCommitsFor(history: HistoryIndex): Map<string, Array<{ time: number; dirs: string[] }>> {
+  let hit = byAuthor.get(history);
+  if (hit) return hit;
+  hit = new Map();
+  for (const c of history.commits) {
+    if (c.parents.length > 1) continue;
+    const email = c.authorEmail.toLowerCase();
+    const entry = { time: c.time, dirs: [...new Set(c.files.map(topLevel))] };
+    const list = hit.get(email);
+    if (list) list.push(entry);
+    else hit.set(email, [entry]);
+  }
+  for (const list of hit.values()) list.sort((a, b) => a.time - b.time);
+  byAuthor.set(history, hit);
+  return hit;
+}
+
 function ownerRatio(ctx: ScoringContext, email: string): Signal {
   const id = "expertise.owner_ratio";
   const existing = countedFiles(ctx).filter((f) => f.status !== "added");
