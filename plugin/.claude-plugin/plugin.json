  "author": { "name": "error-path", "url": "https://github.com/error-path" },
  "homepage": "https://github.com/error-path/opendrs",
  "repository": "https://github.com/error-path/opendrs",
  "license": "MIT",
  "keywords": ["blast-radius", "pr-risk", "risk-score", "code-review", "auto-approve", "auto-merge", "merge-queue", "ai-code-review", "diff-risk-score"],
  "mcpServers": {
    "opendrs": { "command": "npx", "args": ["-y", "@error-path/opendrs@0.5.2", "mcp"] }
  }
}
